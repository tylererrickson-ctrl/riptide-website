# Sanity (sanity.io/manage -> project -> API)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token: used for draft preview + live updates (server-side only)
SANITY_API_READ_TOKEN=
# Editor token: only needed locally to run `npm run content:import`
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity publish webhook (publish log + revalidation)
SANITY_WEBHOOK_SECRET=

# Set to "true" ONLY on the production deployment once the site is live.
# Anything else (staging, previews, local) is served noindex. See scripts/check-indexing.mjs
SITE_INDEXABLE=
NEXT_PUBLIC_SITE_URL=https://www.riptide-advisors.com
GATE_LOG_SALT=

# Contact forms → Notion (see migration/forms.md)
NOTION_API_KEY=
NOTION_PM_DATA_SOURCE_ID=49da9ae6-ee9b-83c7-b91c-8785b2480cee
NOTION_INVESTOR_DATA_SOURCE_ID=711e3e24-39fa-48b8-b1e5-7bd670aaf38d
